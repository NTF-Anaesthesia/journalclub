rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function member(uid) { return exists(/databases/$(database)/documents/members/$(uid)); }
    function isMember() { return signedIn() && member(request.auth.uid); }
    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow-list. A person reads their own row; admins read and change every row.
    // Joining is only possible by redeeming an unused, unexpired invite in the same batch.
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'inviteId', 'joinedAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.joinedAt == request.time
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.usedBy == uid
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.used == false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name']);
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // One-time invite links. The id is the unguessable token, so a signed-in person can
    // fetch one invite by id but nobody except admins can list them.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'expiresAt', 'used', 'note'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.used == false
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
      allow update: if signedIn()
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.inviteId == token;
      allow delete: if isAdmin();
    }

    // Library. Members read everything; the person who added a paper (or an admin) edits it.
    function paper(pid) { return get(/databases/$(database)/documents/papers/$(pid)).data; }
    function mayEditPaper(pid) { return isAdmin() || (isMember() && paper(pid).addedBy == request.auth.uid); }

    match /papers/{pid} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['doi', 'pmid', 'title', 'authors', 'journal', 'year', 'abstract',
             'oa', 'tags', 'why', 'addedBy', 'addedAt'])
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 20;
      allow update: if mayEditPaper(pid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags', 'why', 'file'])
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 20;
      allow delete: if mayEditPaper(pid);

      // One note and rating per member per paper.
      match /notes/{uid} {
        allow write: if isMember() && request.auth.uid == uid
          && (request.method == 'delete' || (
            request.resource.data.keys().hasOnly(['text', 'rating', 'name', 'updatedAt'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 4000
            && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
            && request.resource.data.updatedAt == request.time));
      }

      // Journal club votes: one per member per paper. No update, so a vote can't be cast twice; delete undoes it.
      match /votes/{uid} {
        allow create: if isMember() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/papers/$(pid))
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if isMember() && request.auth.uid == uid;
      }
    }
    match /{path=**}/notes/{uid} { allow read: if isMember(); }
    match /{path=**}/votes/{uid} { allow read: if isMember(); }

    // PDF text per page, written at upload by whoever may edit the paper.
    match /texts/{pid} {
      allow read: if isMember();
      allow write: if mayEditPaper(pid)
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['pages']) && request.resource.data.pages is list));
    }

    // Reading lists: any member makes one; its maker or an admin edits it.
    match /lists/{lid} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['name', 'about', 'paperIds', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.paperIds is list;
      allow update: if (isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'about', 'paperIds'])
        && request.resource.data.paperIds is list && request.resource.data.paperIds.size() <= 500;
      allow delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
    }

    // Presenter rota: members read it, only admins change it.
    match /rota/{rid} {
      allow read: if isMember();
      allow write: if isAdmin()
        && (request.method == 'delete' || (
          request.resource.data.keys().hasOnly(['order', 'next', 'updatedBy', 'updatedAt'])
          && request.resource.data.order is list && request.resource.data.order.size() <= 300
          && request.resource.data.next is int && request.resource.data.next >= 0
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time));
    }

    // Journal club sessions: admins plan them; the presenter fills in the summary and slides link.
    function sessionOk(d) {
      return d.date is timestamp
        && d.paperId is string && d.paperTitle is string && d.presenterUid is string && d.presenterName is string
        && d.summary is string && d.summary.size() <= 8000
        && d.slides is string && d.slides.matches('(https://[^ "<>]+)?');
    }
    match /sessions/{sid} {
      allow read: if isMember();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'paperId', 'paperTitle', 'presenterUid', 'presenterName',
             'summary', 'slides', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && sessionOk(request.resource.data);
      allow update: if sessionOk(request.resource.data) && (
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'paperId', 'paperTitle',
           'presenterUid', 'presenterName', 'summary', 'slides']))
        || (isMember() && resource.data.presenterUid == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['summary', 'slides'])));
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
