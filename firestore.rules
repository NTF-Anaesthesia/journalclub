rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function member(uid) { return exists(/databases/$(database)/documents/members/$(uid)); }
    function isMember() { return signedIn() && member(request.auth.uid); }
    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    // A single-use invite is consumed in the same batch; a group invite stays open until it expires or an admin deletes it.
    function inviteRedeemable(token, uid) {
      let inv = get(/databases/$(database)/documents/invites/$(token)).data;
      return inv.get('group', false) == true
        ? inv.expiresAt > request.time
        : (inv.used == false
           && getAfter(/databases/$(database)/documents/invites/$(token)).data.usedBy == uid);
    }

    // Allow-list. A person reads their own row; admins read and change every row.
    // Joining is only possible by redeeming an unused, unexpired invite in the same batch.
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'inviteId', 'joinedAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.joinedAt == request.time
        && inviteRedeemable(request.resource.data.inviteId, uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name']);
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // One-time invite links. The id is the unguessable token, so a signed-in person can
    // fetch one invite by id but nobody except admins can list them.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'expiresAt', 'used', 'note', 'group'])
        && (!('group' in request.resource.data) || request.resource.data.group is bool)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.used == false
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
      allow update: if signedIn()
        && resource.data.get('group', false) == false
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.inviteId == token;
      allow delete: if isAdmin();
    }

    // Library. Members read everything; the person who added a paper (or an admin) edits it.
    function paper(pid) { return get(/databases/$(database)/documents/papers/$(pid)).data; }
    function mayEditPaper(pid) { return isAdmin() || (isMember() && paper(pid).addedBy == request.auth.uid); }

    // changedAt (the library's catalogue sync stamp), when an update sets it, must be the server time.
    function changedAtNowIfSet() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['changedAt'])
        || request.resource.data.changedAt == request.time;
    }

    function changed(k) { return k in request.resource.data.diff(resource.data).affectedKeys(); }

    match /papers/{pid} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['doi', 'pmid', 'title', 'authors', 'journal', 'year', 'abstract',
             'oa', 'tags', 'why', 'addedBy', 'addedAt', 'changedAt'])
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time
        && request.resource.data.get('changedAt', request.time) == request.time
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 20;
      allow update: if (mayEditPaper(pid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags', 'why', 'file', 'changedAt'])
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 20
        && changedAtNowIfSet())
        // An admin's "Refresh abstracts" rewrites bibliographic fields (doi/pmid only where the paper had none).
        || (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'journal', 'authors', 'abstract', 'doi', 'pmid', 'year', 'abstractSource', 'changedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.authors is list
        && (!('doi' in request.resource.data.diff(resource.data).affectedKeys()) || resource.data.get('doi', '') == '')
        && (!('pmid' in request.resource.data.diff(resource.data).affectedKeys()) || resource.data.get('pmid', '') == '')
        && changedAtNowIfSet())
        // An admin's "Tidy ATOTW": title, journal, year and the tutorial number (an int 1-2000; only admins write it).
        || (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'journal', 'year', 'atotw', 'manual', 'changedAt'])
        && (!changed('title') || (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 500))
        && (!changed('journal') || (request.resource.data.journal is string && request.resource.data.journal.size() <= 300))
        && (!changed('year') || (request.resource.data.year is int && request.resource.data.year >= 1800 && request.resource.data.year <= 2100))
        && (!changed('atotw') || (request.resource.data.atotw is int && request.resource.data.atotw >= 1 && request.resource.data.atotw <= 2000))
        && (!changed('manual') || (request.resource.data.manual is list && request.resource.data.manual.size() <= 10))
        && changedAtNowIfSet())
        // Any member edits a paper's details by hand ("Edit details"): `manual` lists the fields they typed, so
        // Refresh and "Fill missing details" leave those alone. Each field is checked only when it changes.
        || (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'authors', 'journal', 'year', 'doi', 'pmid',
             'abstract', 'abstractSource', 'manual', 'tags', 'why', 'changedAt'])
        && (!changed('title') || (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 500))
        && (!changed('authors') || (request.resource.data.authors is list && request.resource.data.authors.size() <= 100))
        && (!changed('journal') || (request.resource.data.journal is string && request.resource.data.journal.size() <= 300))
        && (!changed('year') || request.resource.data.year == null
            || (request.resource.data.year is int && request.resource.data.year >= 1800 && request.resource.data.year <= 2100))
        && (!changed('doi') || (request.resource.data.doi is string && request.resource.data.doi.size() <= 200
            && (request.resource.data.doi == '' || request.resource.data.doi.matches('10[.].*'))))
        && (!changed('pmid') || (request.resource.data.pmid is string && request.resource.data.pmid.matches('[0-9]{0,9}')))
        && (!changed('abstract') || (request.resource.data.abstract is string && request.resource.data.abstract.size() <= 20000))
        && (!changed('abstractSource') || request.resource.data.abstractSource in ['lookup', 'pdf', 'ai', 'hand'])
        && (!changed('manual') || (request.resource.data.manual is list && request.resource.data.manual.size() <= 10))
        && (!changed('tags') || (request.resource.data.tags is list && request.resource.data.tags.size() <= 20))
        && (!changed('why') || (request.resource.data.why is string && request.resource.data.why.size() <= 200))
        && changedAtNowIfSet())
        // Any member tags papers (one at a time or in bulk from select mode); tags only.
        || (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags', 'changedAt'])
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 20
        && changedAtNowIfSet())
        // Any member planning a session keeps the paper's `presented` summary in step (written in the session's batch).
        || (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['presented', 'changedAt'])
        && request.resource.data.presented is list && request.resource.data.presented.size() <= 100
        && changedAtNowIfSet());
      allow delete: if mayEditPaper(pid);

      // One note and rating per member per paper. A note is private to its writer unless `shared` is true (a note
      // without the field counts as private). Nobody else reads a private note, admins included. An admin merging
      // duplicates may create a missing note, change a shared one and clear any, moving members' shared notes across
      // (keeping each note's own updatedAt); a private note is never read or overwritten by an admin.
      function noteOk(d) {
        return d.keys().hasOnly(['text', 'rating', 'name', 'shared', 'updatedAt'])
          && d.text is string && d.text.size() <= 4000
          && d.rating is int && d.rating >= 0 && d.rating <= 5
          && (!('shared' in d) || d.shared is bool);
      }
      match /notes/{uid} {
        allow write: if isMember() && request.auth.uid == uid
          && (request.method == 'delete' || (noteOk(request.resource.data) && request.resource.data.updatedAt == request.time));
        allow create: if isAdmin() && noteOk(request.resource.data) && request.resource.data.updatedAt is timestamp;
        allow update: if isAdmin() && resource.data.get('shared', false) == true
          && noteOk(request.resource.data) && request.resource.data.updatedAt is timestamp;
        allow delete: if isAdmin();
      }

    }
    // Notes are read by their writer, and by members when shared. A list or collection-group query must itself
    // filter on shared == true (or be the writer's own doc), so private notes never reach another member's query.
    function noteReadable(uid) { return isMember() && (request.auth.uid == uid || resource.data.get('shared', false) == true); }
    match /{path=**}/notes/{uid} { allow read: if noteReadable(uid); }

    // Old per-page PDF text, from before search moved to the Worker (D1). Read by the admin backfill; no new writes.
    match /texts/{pid} {
      allow read: if isMember();
      allow delete: if mayEditPaper(pid);
    }

    // Reading lists: `visibility` private (the maker only) or shared (every member reads it and adds or removes
    // papers; the maker or an admin renames or deletes it). Lists from before visibility existed count as shared
    // until an admin's app stamps them. Each member's Starred list is `lists/star-<uid>`, private, kind "starred".
    // Admins read every list, so merging duplicates can repoint papers in private lists too.
    function listShared(d) { return d.get('visibility', 'shared') == 'shared'; }
    function listOk(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.paperIds is list && d.paperIds.size() <= 2000
        && d.get('visibility', 'shared') in ['private', 'shared'];
    }
    match /lists/{lid} {
      // A list that doesn't exist (yet: a member's Starred list) reads as missing rather than denied.
      allow get: if isMember() && (resource == null || listShared(resource.data) || resource.data.createdBy == request.auth.uid || isAdmin());
      // Queries: where visibility == shared, or where createdBy == me; admins list everything.
      allow list: if isMember() && (resource.data.visibility == 'shared' || resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['name', 'about', 'paperIds', 'createdBy', 'createdAt', 'visibility', 'kind'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.visibility in ['private', 'shared']
        && listOk(request.resource.data)
        && (!('kind' in request.resource.data)
            || (request.resource.data.kind == 'starred' && lid == 'star-' + request.auth.uid
                && request.resource.data.visibility == 'private'));
      allow update: if listOk(request.resource.data) && (
        ((isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'about', 'paperIds', 'visibility'])
          && (resource.data.get('kind', '') != 'starred' || request.resource.data.visibility == 'private'))
        || (isMember() && listShared(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paperIds'])));
      allow delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
    }

    // Per-member preferences synced across devices: the last 20 papers opened. Own doc only.
    match /users/{uid} {
      allow read: if isMember() && request.auth.uid == uid;
      allow write: if isMember() && request.auth.uid == uid
        && (request.method == 'delete' || (
          request.resource.data.keys().hasOnly(['recent', 'searches', 'noted', 'notedScan', 'updatedAt'])
          && (!('recent' in request.resource.data)
            || (request.resource.data.recent is list && request.resource.data.recent.size() <= 20))
          && (!('searches' in request.resource.data)
            || (request.resource.data.searches is list && request.resource.data.searches.size() <= 20))
          && (!('noted' in request.resource.data)
            || (request.resource.data.noted is map && request.resource.data.noted.size() <= 3000))
          && (!('notedScan' in request.resource.data) || request.resource.data.notedScan is number)
          && request.resource.data.updatedAt == request.time));

      // My private notes on a journal club session (id = the session id). Owner only: not readable by other members or
      // admins, and not part of any collection-group read.
      match /sessionNotes/{sid} {
        allow read: if isMember() && request.auth.uid == uid;
        allow write: if isMember() && request.auth.uid == uid
          && (request.method == 'delete' || (
            request.resource.data.keys().hasOnly(['text', 'paperId', 'paperTitle', 'date', 'updatedAt'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 8000
            && request.resource.data.get('paperId', '') is string && request.resource.data.get('paperId', '').size() <= 100
            && request.resource.data.get('paperTitle', '') is string && request.resource.data.get('paperTitle', '').size() <= 400
            && (request.resource.data.get('date', null) == null || request.resource.data.get('date', null) is timestamp)
            && request.resource.data.updatedAt == request.time));
      }
    }

    // A member's private session notes: only they read them (admins included). The session page writes them. The paper
    // page and Saved read them here.
    match /users/{uid}/sessionNotes/{sid} {
      allow read: if isMember() && request.auth.uid == uid;
    }

    // Club settings: members read (the Teams link is for them); only admins change the Teams link, prompt,
    // default start time and the default discussion form.
    match /config/{cid} {
      allow read: if isMember();
      allow write: if isAdmin()
        && (request.method == 'delete' || (
          cid in ['club', 'discussion']
          && request.resource.data.keys().hasOnly(['teamsUrl', 'pointPrompt', 'time', 'weekday', 'fields', 'updatedBy', 'updatedAt'])
          && request.resource.data.get('weekday', 0) is int && request.resource.data.get('weekday', 0) >= 0 && request.resource.data.get('weekday', 0) <= 6
          && request.resource.data.get('teamsUrl', '').matches('(https://[^ "<>]+)?')
          && request.resource.data.get('fields', []) is list && request.resource.data.get('fields', []).size() <= 30
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time));
    }

    // Teaching slide decks: any member adds one (and is its maker); the maker and admins edit or delete it. The file
    // itself is in R2 (the Worker), described by slidesFile as on a session.
    function deckOk(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.tags is list && d.tags.size() <= 20
        && d.by is string && d.by.size() <= 120
        && d.about is string && d.about.size() <= 4000
        && (d.get('date', null) == null || d.get('date', null) is timestamp)
        && d.get('slidesFile', {}) is map && slidesFileOk(d.get('slidesFile', {}))
        && d.get('changedAt', request.time) == request.time;
    }
    function mayEditDeck(d) { return isAdmin() || (isMember() && d.createdBy == request.auth.uid); }
    match /decks/{did} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['title', 'tags', 'by', 'about', 'date', 'slidesFile', 'createdBy', 'createdAt', 'changedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && deckOk(request.resource.data);
      allow update: if mayEditDeck(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'tags', 'by', 'about', 'date', 'slidesFile', 'changedAt'])
        && deckOk(request.resource.data);
      allow delete: if mayEditDeck(resource.data);
    }

    // Journal club sessions: any member plans one (and is its creator); the creator, the presenter, a member
    // coordinator and admins edit the plan and fill in the summary, slides (slidesFile) and discussion until it is locked.
    // Only admins lock a session or change its discussion-form override; admins and the creator delete it.
    function sessionOk(d) {
      return d.date is timestamp
        && d.paperId is string && d.paperTitle is string && d.presenterUid is string && d.presenterName is string
        && d.presenterName.size() <= 120
        && d.summary is string && d.summary.size() <= 8000
        && d.slides is string && d.slides.matches('(https://[^ "<>]+)?')
        && d.get('coordinatorUid', '') is string && d.get('coordinatorName', '') is string
        && d.get('coordinatorName', '').size() <= 120
        && d.get('teamsUrl', '') is string && d.get('teamsUrl', '').matches('(https://[^ "<>]+)?')
        && d.get('time', '') is string && d.get('time', '').matches('([01][0-9]|2[0-3]):[0-5][0-9]|')
        && d.get('locked', false) is bool
        && d.get('template', []) is list && d.get('template', []).size() <= 30
        && d.get('discussion', {}) is map
        && d.get('discussion', {}).keys().hasOnly(['fields', 'answers'])
        && d.get('slidesFile', {}) is map && slidesFileOk(d.get('slidesFile', {}));
    }
    // The uploaded slides (stored in R2 by the Worker): {} once removed.
    function slidesFileOk(f) {
      return f.keys().hasOnly(['name', 'size', 'kind', 'pdf'])
        && f.get('name', '') is string && f.get('name', '').size() <= 200
        && f.get('size', 0) is int && f.get('kind', 'pdf') in ['pdf', 'pptx', 'ppt'] && f.get('pdf', false) is bool;
    }
    function mayPlan(d) {
      return isMember() && !d.get('locked', false)
        && (d.get('createdBy', '') == request.auth.uid || d.presenterUid == request.auth.uid
            || d.get('coordinatorUid', '') == request.auth.uid);
    }
    match /sessions/{sid} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['date', 'paperId', 'paperTitle', 'presenterUid', 'presenterName',
             'summary', 'slides', 'createdBy', 'createdAt', 'coordinatorUid', 'coordinatorName', 'time', 'teamsUrl'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && sessionOk(request.resource.data);
      allow update: if sessionOk(request.resource.data) && (
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'paperId', 'paperTitle',
           'presenterUid', 'presenterName', 'summary', 'slides', 'coordinatorUid', 'coordinatorName', 'time',
           'teamsUrl', 'template', 'locked', 'discussion', 'slidesFile']))
        || (mayPlan(resource.data)
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'paperId', 'paperTitle',
              'presenterUid', 'presenterName', 'summary', 'slides', 'coordinatorUid', 'coordinatorName', 'time',
              'teamsUrl', 'discussion', 'slidesFile'])));
      allow delete: if isAdmin() || (isMember() && resource.data.get('createdBy', '') == request.auth.uid);

      // One take-home point per member per session; read-only once the session is locked. `plus` is the set of members who
      // agree ("me too"): the point's owner never changes it, and anyone else may add or remove only their own uid.
      function sessionOpen() { return !get(/databases/$(database)/documents/sessions/$(sid)).data.get('locked', false); }
      match /points/{uid} {
        allow write: if isMember() && request.auth.uid == uid && sessionOpen()
          && (request.method == 'delete' || (
            request.resource.data.keys().hasOnly(['text', 'name', 'updatedAt', 'plus'])
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
            && request.resource.data.name is string && request.resource.data.name.size() <= 120
            && request.resource.data.updatedAt == request.time
            && request.resource.data.get('plus', []) == (resource == null ? [] : resource.data.get('plus', []))));
        allow update: if isMember() && request.auth.uid != uid && sessionOpen()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plus'])
          && request.resource.data.plus is list && request.resource.data.plus.size() <= 300
          && ((request.resource.data.plus.hasAll(resource.data.get('plus', []))
               && request.resource.data.plus.size() == resource.data.get('plus', []).size() + 1
               && request.resource.data.plus.hasAny([request.auth.uid])
               && !resource.data.get('plus', []).hasAny([request.auth.uid]))
            || (resource.data.get('plus', []).hasAll(request.resource.data.plus)
               && request.resource.data.plus.size() == resource.data.get('plus', []).size() - 1
               && resource.data.get('plus', []).hasAny([request.auth.uid])
               && !request.resource.data.plus.hasAny([request.auth.uid])));
        allow delete: if isAdmin();
      }
    }
    match /{path=**}/points/{uid} { allow read: if isMember(); }

    // Removal flags: any member asks, admins review (Remove opens the removal page, Dismiss deletes the flag).
    match /flags/{fid} {
      allow read: if isAdmin();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['paperId', 'paperTitle', 'what', 'reason', 'by', 'byName', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.what in ['pdf', 'paper']
        && request.resource.data.paperId is string && request.resource.data.paperTitle is string
        && request.resource.data.byName is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
        && exists(/databases/$(database)/documents/papers/$(request.resource.data.paperId));
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
