{
  "name": "journalclub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --minify --outfile=public/app.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-jc \"node --test rules-test/rules.test.js\"",
    "test:e2e": "npm run build && firebase emulators:exec --only firestore,auth --project demo-jc \"playwright test\"",
    "test": "npm run test:rules && npm run test:e2e"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.1",
    "http-server": "^14.1.1",
    "wrangler": "^4.152.0"
  }
}