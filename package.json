{
  "name": "journalclub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --splitting --minify --outdir=public --chunk-names=chunks/[name]-[hash] && node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-jc \"node --test rules-test/rules.test.js\"",
    "test:e2e": "npm run build && firebase emulators:exec --only firestore,auth --project demo-jc \"playwright test\"",
    "test": "npm run test:unit && npm run build && firebase emulators:exec --only firestore,auth --project demo-jc \"playwright test && node --test rules-test/rules.test.js\"",
    "test:unit-rules": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.1",
    "http-server": "^14.1.1",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4",
    "wrangler": "^4.152.0"
  }
}
